name: Keep Supabase awake

on:
  schedule:
    - cron: "0 14 * * 1,4"
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Query the database
        run: |
          curl --fail --silent --show-error --max-time 30 \
            "https://oampcsuxwmzyqrwknzlb.supabase.co/rest/v1/dashboard_state?select=id&limit=1" \
            -H "apikey: sb_publishable_s0tFXgZzw9MJeVC4bBp30A__WCM6njD"
          echo
          echo "Ping OK"
